{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hexo-Studio",
  "version": "1.0.0",
  "identifier": "local.hexo-studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3031",
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hexo-Studio",
        "create": false,
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "Hexo-Studio",
    "longDescription": "Write, preview with the real theme, and deploy a Hexo blog.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1M0UzOEMyOUFGOEIyMTcKUldRWHN2aWF3amcrcGVKQzBlTEFiamNxOFlnM1dyRTI2N3l1NmNwTUpsUCtkbGpNa1BVUkNXb1MK",
      "endpoints": [
        "https://github.com/EverettRain/Hexo-Studio/releases/latest/download/latest.json"
      ]
    }
  }
}
